<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WageTracker.Application\WageTracker.Application.csproj" />
    <ProjectReference Include="..\WageTracker.Infrastructure\WageTracker.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WageTracker.WinForms.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>WageTracker</AssemblyName>
    <RootNamespace>WageTracker.WinForms</RootNamespace>
    <ApplicationIcon>Resources\WageTracker.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>WageTracker</Product>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\WageTracker.ico" LogicalName="WageTracker.ico" />
  </ItemGroup>

</Project>
